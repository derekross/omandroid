#!/bin/bash
# SPDX-License-Identifier: MIT
# The installer's tests (no phone, nothing flashed): tools/install-phone
# against a fake fastboot, tools/phone-provision against a synthetic backup
# (and a container standing in for the phone, with Docker), the initramfs's
# first-boot growth, the simplefb trigger, bin/omamobile's boot-image layouts
# and flash against a fake fastboot, omamobile-firstboot's own tests, and the
# smoke test of the newest root image in out/ if there is one.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
for f in tools/install-phone tools/phone-provision tools/build-rootfs tools/build-packages tools/make-bundle \
         tools/lib/alarm.sh tools/lib/alarm-setup rootfs/build-inside tests/*; do
  [[ -f $f ]] || continue   # tests/owl is the OWL conformance suite's folder
  bash -n "$f" || { echo "not ok - $f parses" >&2; exit 1; }
done
sh -n initramfs/init
echo "ok - scripts parse"
for t in tests/install-phone tests/phone-provision tests/initramfs-grow tests/images-layout tests/simplefb-trigger packages/omamobile-firstboot/test/all; do
  echo "# $t"
  "$t"
done
shopt -s nullglob
latest=""
for f in out/omamobile-rootfs-*-aarch64.img.zst; do latest=$f; done
if [[ -n $latest ]]; then
  echo "# tests/rootfs-smoke $latest"
  tests/rootfs-smoke "$latest"
else
  echo "ok - # skip: no root image in out/ for tests/rootfs-smoke (tools/build-rootfs)"
fi
