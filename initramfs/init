#!/bin/sh
# SPDX-License-Identifier: MIT
# Shared first-light init. One script for every device.
# The only display-register write is the pair in /etc/omamobile-simplefb-trig,
# which bin/omamobile initramfs installs from SIMPLEFB_TRIG_CON. The init
# writes it only when the board's first compatible string matches
# /etc/omamobile-compatible, the descriptor's COMPATIBLE packed beside it.
# No trigger file, or a different board, means no write. The bring-up probe
# uses that same check, so a cheetah image does not read every DPP elsewhere.
# Host side: the phone appears as a USB network adapter; ssh root@172.16.42.1

export PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t configfs configfs /sys/kernel/config
mount -t tmpfs tmpfs /run

# With "splash" on the command line, Plymouth shows the boot animation once
# Arch starts, so keep status lines off the screen (they still go to kmsg).
# Storage-guard warnings always show.
SCREEN=/dev/tty0
if grep -qw splash /proc/cmdline; then
  SCREEN=/dev/null
  # Replace the bootloader's logo with Omarchy's at once; Plymouth draws the
  # same screen when Arch starts, so the two join up.
  [ -f /splash.bgra.gz ] && zcat /splash.bgra.gz > /dev/fb0 2>/dev/null
fi

# --- UFS safety: every SCSI disk is read-only, before anything else runs ---
# The UFS device holds irreplaceable per-device calibration (efs, persist,
# modem_userdata). Until UFS support is trusted, mark every /dev/sd* disk and
# partition read-only as soon as it appears, and never mount anything. The
# driver is built in, so disks can exist before init starts or show up while
# it runs: do one pass now, then keep a watcher running for the life of PID 1.
# Nothing in this initramfs runs mdev/udev, so no one else touches the disks.
ufs_ro_log() { echo "omamobile: ufs-ro: $*" > /dev/kmsg; }
# Storage guard. Everything on the UFS is read-only except an allowlist of
# partitions we own: slot B's boot images (in-place kernel updates) and
# userdata (the Arch root). The kernel only lets a partition be written if
# its whole disk is writable too, so the main disk (sda) stays writable but
# its whole-disk node is removed, so nothing can write across partitions by
# accident. The boot LUNs (sdb, sdc, sdd: bootloader images) are read-only
# at the disk level. Calibration partitions (efs, persist, modem_userdata...)
# and all of slot A stay read-only.
UFS_RW="boot_b init_boot_b vendor_boot_b vendor_kernel_boot_b dtbo_b userdata"
mkdir -p /run/ufs-ro
ufs_partname() { sed -n 's/^PARTNAME=//p' "$1/uevent" 2>/dev/null; }
ufs_ro_pass() {
  local s ro name part disk
  for s in /sys/block/sd* /sys/block/sd*/sd*; do
    [ -r "$s/ro" ] || continue
    name=${s##*/}
    [ -e "/run/ufs-ro/$name" ] && continue
    [ -b "/dev/$name" ] || continue  # devtmpfs node not there yet: next pass
    if [ "$name" = sda ]; then
      rm -f /dev/sda
      : > "/run/ufs-ro/$name"
      ufs_ro_log "/dev/sda: whole-disk node removed (partitions guarded individually)"
      continue
    fi
    part=$(ufs_partname "$s")
    if [ -n "$part" ] && [ "${name%%[0-9]*}" = sda ] && \
       case " $UFS_RW " in *" $part "*) true ;; *) false ;; esac; then
      : > "/run/ufs-ro/$name"
      ufs_ro_log "/dev/$name ($part) left writable (allowlist)"
      continue
    fi
    blockdev --setro "/dev/$name"
    read -r ro < "$s/ro"
    if [ "$ro" = 1 ]; then
      : > "/run/ufs-ro/$name"
      ufs_ro_log "/dev/$name${part:+ ($part)} set read-only"
    elif [ ! -e "/run/ufs-ro/$name.failed" ]; then
      : > "/run/ufs-ro/$name.failed"  # keep retrying, but log once
      ufs_ro_log "FAILED to set /dev/$name read-only"
      echo "omamobile: WARNING: /dev/$name is NOT read-only" > /dev/tty0 2>/dev/null
    fi
  done
}
ufs_ro_pass
( while true; do ufs_ro_pass; sleep 0.2 2>/dev/null || sleep 1; done ) &
ufs_ro_log "guard running (pid $!)"

hostname omamobile

say() { echo "omamobile: $*" | tee /dev/kmsg > $SCREEN 2>/dev/null; }

# Return 0 when this image was packed for the board that is running.
# $1 names the step in the skip line. A missing or different COMPATIBLE
# skips the step, so a cheetah image cannot touch a Fold.
board_matches() {
  local what=$1 want got
  if [ ! -s /etc/omamobile-compatible ]; then
    say "$what skipped: image has no board compatible"
    return 1
  fi
  read -r want < /etc/omamobile-compatible
  got=$(tr '\0' '\n' < /proc/device-tree/compatible | head -n 1)
  if [ "$got" != "$want" ]; then
    say "$what skipped: board is ${got:-unknown}, image is $want"
    return 1
  fi
  return 0
}

# Command-mode panels take a new frame only when their DECON sends one.
# ABL masks that trigger after the logo. The descriptor's SIMPLEFB_TRIG_CON
# is the address and value for this phone (TRIG_CON: clear
# HW_TRIG_MASK_DECON, set HW_TRIG_EN). devmem's second argument is the
# value, not a width. Stopgap until a real DECON/DSI driver.
simplefb_trigger() {
  local trig_addr trig_val
  [ -s /etc/omamobile-simplefb-trig ] || return 0
  board_matches "simplefb trigger" || return 0
  read -r trig_addr trig_val < /etc/omamobile-simplefb-trig
  devmem "$trig_addr" "$trig_val" >/dev/null || say "simplefb trigger failed"
}
simplefb_trigger

clear > $SCREEN 2>/dev/null

# Bring-up probes: watchdog control registers, and the buffer address each
# display DMA channel (DPP) is scanning out, i.e. where ABL's framebuffer is.
# The packer installs the marker only when the descriptor sets BRINGUP_PROBE=1.
# The reads cover every DPP, so they also require this image's board.
probe() {
  {
    for w in 0x10060000 0x10070000; do echo "wtcon $w $(devmem $w)"; done
    for n in 0 1 2 3 4 5 8 9 c; do
      b=$((0x1c0b0000 + 0x$n * 0x1000))
      echo "dpp$n cfg $(devmem $b) base $(devmem $((b + 0x40))) $(devmem $((b + 0x44)))"
    done
  } > /run/probe.txt 2>&1
  while read -r line; do echo "omamobile: $line" > /dev/kmsg; done < /run/probe.txt
}
maybe_probe() {
  [ -f /etc/omamobile-bringup-probe ] || return 0
  board_matches "bring-up probe" || return 0
  probe
}
maybe_probe
say "first light on $(cat /proc/sys/kernel/osrelease)"

# USB gadget: CDC NCM network + ACM serial console
g=/sys/kernel/config/usb_gadget/g1
mkdir -p $g/strings/0x409 $g/configs/c.1/strings/0x409
echo 0x1d6b > $g/idVendor          # Linux Foundation
echo 0x0104 > $g/idProduct         # Multifunction composite gadget
echo "Omarchy Mobile" > $g/strings/0x409/manufacturer
echo "Pixel 7 Pro (M1)" > $g/strings/0x409/product
echo "omamobile" > $g/strings/0x409/serialnumber
echo "NCM + ACM" > $g/configs/c.1/strings/0x409/configuration
mkdir -p $g/functions/ncm.usb0 $g/functions/acm.GS0
ln -s $g/functions/ncm.usb0 $g/configs/c.1/
ln -s $g/functions/acm.GS0 $g/configs/c.1/

udc=""
for i in $(seq 1 30); do
  udc=$(ls /sys/class/udc 2>/dev/null | head -1)
  [ -n "$udc" ] && break
  sleep 1
done
if [ -n "$udc" ]; then
  echo "$udc" > $g/UDC && say "USB gadget up on $udc"
else
  say "no USB device controller found"
fi

# Network: phone is 172.16.42.1, host gets 172.16.42.2 from udhcpd
ip link set lo up
for i in $(seq 1 10); do ip link show usb0 >/dev/null 2>&1 && break; sleep 1; done
ip addr add 172.16.42.1/24 dev usb0 && ip link set usb0 up
cat > /run/udhcpd.conf <<CONF
start 172.16.42.2
end 172.16.42.2
interface usb0
option subnet 255.255.255.0
lease_file /run/udhcpd.leases
CONF
touch /run/udhcpd.leases
udhcpd /run/udhcpd.conf

# ssh with the developer's key, and a root shell on the USB serial port
mkdir -p /etc/dropbear
dropbear -R -E -p 22 2>/dev/null && say "ssh: root@172.16.42.1"
( while true; do setsid getty -n -l /bin/sh 115200 ttyGS0 vt100; sleep 1; done ) &

# Bring-up diagnostics on screen when the cmdline has omamobile.debug: USB log
# lines, whether interrupts arrive, and what the bootloader passed in.
grep -q omamobile.debug /proc/cmdline && {
  echo "--- usb/phy/dwc3 ---"
  dmesg | grep -iE 'dwc3|phy|udc|gadget|11210000|pmu' | tail -14
  echo "--- interrupts (timer, usb) at two points ---"
  grep -iE 'arch_timer|dwc3|11210000' /proc/interrupts | cut -c1-90
  i=0; while [ $i -lt 300000 ]; do i=$((i+1)); done
  grep -iE 'arch_timer|dwc3|11210000' /proc/interrupts | cut -c1-90
  echo "--- uptime $(cut -d' ' -f1 /proc/uptime), udc $(cat /sys/class/udc/*/state 2>/dev/null) ---"
  echo "--- cmdline tail ---"
  tr ' ' '\n' < /proc/cmdline | tail -12 | tr '\n' ' '
  echo
} > $SCREEN 2>&1

# UFS probe report when the cmdline has omamobile.ufs-probe: wait for the
# disks to settle, then list them and the GPT partition names. Read-only: it
# only reads /proc and sysfs, after the guard above has marked the disks ro.
grep -q omamobile.ufs-probe /proc/cmdline && (
  last=-1
  for i in $(seq 1 30); do
    n=$(ls -d /sys/block/sd*/sd* 2>/dev/null | wc -l)
    [ "$n" -gt 0 ] && [ "$n" = "$last" ] && break
    last=$n
    sleep 1
  done
  ufs_ro_pass
  {
    echo "=== ufs-probe: $(ls -d /sys/block/sd* 2>/dev/null | wc -l) disks, $n partitions ==="
    cat /proc/partitions
    for d in /sys/block/sd*; do
      [ -e "$d" ] || { echo "no /sys/block/sd* (UFS did not enumerate)"; break; }
      echo "${d##*/}: ro=$(cat "$d/ro") size=$(cat "$d/size") model=$(cat "$d/device/model" 2>/dev/null)"
      for p in "$d"/sd*; do
        [ -e "$p/uevent" ] || continue
        echo "  ${p##*/} ro=$(cat "$p/ro") $(grep '^PARTNAME=' "$p/uevent")"
      done
    done
    echo "=== ufs-probe: dmesg ==="
    dmesg | grep -iE 'ufs|scsi|sd[a-z]|14700000' | tail -25
  } > /run/ufs-probe.txt 2>&1
  cat /run/ufs-probe.txt > $SCREEN 2>/dev/null
  while read -r line; do echo "omamobile: $line" > /dev/kmsg; done < /run/ufs-probe.txt
) &

say "ready"

# Self-recovery for bring-up: if the host never configures the USB gadget,
# show why on screen, then crash so the phone falls back to stock Android.
(
  for i in $(seq 1 45); do
    grep -qx configured /sys/class/udc/*/state 2>/dev/null && exit 0
    sleep 1
  done
  {
    echo
    echo "=== USB never configured; dmesg follows ==="
    dmesg | grep -iE 'dwc3|phy|usb|udc|clk|error|fail' | tail -30
    echo "omamobile: no USB host, crashing in 20 s so ABL falls back to slot A"
  } > $SCREEN
  sleep 20
  # Never in the middle of growing the root file system (boot_arch)
  while [ -e /run/omamobile-resizing ]; do sleep 1; done
  sync
  # reboot-to bootloader is unreliable; a panic (panic=10) reboots, and once
  # slot B is out of retries ABL boots stock Android, which adb can reach
  echo c > /proc/sysrq-trigger
) &





# First boot of a flashed root image (tools/install-phone): the image is a
# few GB, so grow its file system to the whole userdata partition before
# mounting it. Only an Omarchy Mobile root (label omamobile-root) that is
# more than 64 MiB smaller than its partition, so it happens once; a root
# installed any other way is left alone. omamobile.noresize skips it.
grow_root() {
  local dev=$1 info part_bytes fs_bytes blocks bsize
  grep -q omamobile.noresize /proc/cmdline && return 0
  info=$(dumpe2fs -h "$dev" 2>/dev/null)
  [ "$(echo "$info" | sed -n 's/^Filesystem volume name: *//p')" = omamobile-root ] || return 0
  blocks=$(echo "$info" | sed -n 's/^Block count: *//p')
  bsize=$(echo "$info" | sed -n 's/^Block size: *//p')
  part_bytes=$(blockdev --getsize64 "$dev" 2>/dev/null)
  [ -n "$blocks" ] && [ -n "$bsize" ] && [ -n "$part_bytes" ] || return 0
  fs_bytes=$((blocks * bsize))
  [ $((part_bytes - fs_bytes)) -gt 67108864 ] || return 0
  say "arch: growing the root file system to fill $dev ($((fs_bytes >> 20)) MiB to $((part_bytes >> 20)) MiB)"
  : > /run/omamobile-resizing
  e2fsck -f -p "$dev" >/dev/null 2>&1   # resize2fs wants a freshly checked file system
  if resize2fs "$dev" > /run/resize2fs.log 2>&1; then
    say "arch: root file system grown"
  else
    say "arch: resize2fs failed; booting at the old size"
    while read -r line; do echo "omamobile: resize2fs: $line" > /dev/kmsg; done < /run/resize2fs.log
  fi
  rm -f /run/omamobile-resizing
}

# Keep a shell on the screen too
# Hand over to Arch on userdata, unless omamobile.initramfs is on the command
# line. Everything is checked before the irreversible exec; if anything is
# missing we stay here in the initramfs shell.
boot_arch() {
  grep -q omamobile.initramfs /proc/cmdline && return 1
  local dev="" s
  for s in /sys/block/sda/sda*; do
    grep -qx PARTNAME=userdata "$s/uevent" 2>/dev/null && dev=/dev/${s##*/}
  done
  [ -n "$dev" ] || { say "arch: no userdata partition"; return 1; }
  [ "$(cat /sys/block/sda/${dev#/dev/}/ro)" = 0 ] || { say "arch: userdata is read-only"; return 1; }
  mkdir -p /newroot
  e2fsck -p "$dev" >/dev/null 2>&1
  grow_root "$dev"
  mount -t ext4 -o rw,relatime "$dev" /newroot || { say "arch: cannot mount $dev"; return 1; }
  if [ ! -x /newroot/usr/lib/systemd/systemd ]; then
    say "arch: no systemd on $dev"; umount /newroot; return 1
  fi
  say "arch: switching to Arch Linux on $dev"
  # Stop the initramfs helpers (dropbear, udhcpd, guards); the kernel keeps
  # the USB gadget and the partition read-only flags across the switch
  kill -9 -1 2>/dev/null
  sleep 1
  for m in /dev /proc /sys /run; do
    mkdir -p "/newroot$m" && mount --move "$m" "/newroot$m"
  done
  exec switch_root /newroot /usr/lib/systemd/systemd
}
boot_arch

# PID 1 must never exit: if it does the kernel panics and freezes (silently,
# since ABL sets console=null). So keep a shell on the screen in a loop
# instead of exec'ing one. setsid -c makes tty1 its controlling terminal
# (Alpine's busybox has no cttyhack; exec'ing it is what killed PID 1).
while true; do
  setsid -c sh </dev/tty1 >/dev/tty1 2>&1
  sleep 1
done
